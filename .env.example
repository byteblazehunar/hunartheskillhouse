# ========================================================
# HUNAR THE SKILL HOUSE — ENVIRONMENT CONFIGURATION
# ========================================================

# Application Port
PORT=5000

# Backend Base URL (for email links and client requests)
API_BASE_URL=https://hunar.courses/api
FRONTEND_URL=https://hunar.courses/

# MongoDB Connection String
# For Atlas, URL-encode reserved characters in the username/password (for example @ as %40).
MONGODB_URI=mongodb://localhost:27017/hunar_db

# JWT Secret for Session Authentication
# Generate a unique random value with at least 32 bytes of entropy.
JWT_SECRET=replace-with-a-unique-random-secret

# Invitation Token Expiry (in hours)
INVITATION_EXPIRY_HOURS=72

# Required only once when the connected database has no admin account.
INITIAL_ADMIN_NAME=Your Name
INITIAL_ADMIN_EMAIL=you@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Email Service Configuration
# For Gmail, use a Google App Password (not the normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-account@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Hunar The Skill House <your-gmail-account@gmail.com>"
INQUIRY_NOTIFICATION_EMAIL=admissions@hunar.courses

# Security & CORS
NODE_ENV=production
ALLOWED_ORIGINS=https://hunar.courses,https://www.hunar.courses
