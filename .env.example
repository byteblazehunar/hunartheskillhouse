# ========================================================
# HUNAR THE SKILL HOUSE — ENVIRONMENT CONFIGURATION
# ========================================================

# Application Port
PORT=5000

# Backend Base URL (for email links and client requests)
API_BASE_URL=http://localhost:5000/api,https://hunar.courses/api
FRONTEND_URL=http://localhost:5173,https://hunar.courses/

# MongoDB Connection String
# Replace with your local MongoDB or MongoDB Atlas URI.
MONGODB_URI=mongodb://localhost:27017/hunar_db

# JWT Secret for Session Authentication
# Generate a unique random value with at least 32 bytes of entropy.
JWT_SECRET=replace-with-a-unique-random-secret

# Invitation Token Expiry (in hours)
INVITATION_EXPIRY_HOURS=72

# Required only when creating the initial accounts in an empty data store.
# Use a different, strong password for each account.
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-admin-password
INITIAL_TEACHER_PASSWORD=replace-with-a-unique-teacher-password
INITIAL_RECEPTIONIST_PASSWORD=replace-with-a-unique-receptionist-password
INITIAL_ACCOUNTANT_PASSWORD=replace-with-a-unique-accountant-password

# Email Service Configuration (Optional / Mock mode active if empty)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=admissions@hunar.courses
# SMTP_PASS=your-app-password
# SMTP_FROM="Hunar The Skill House <admissions@hunar.courses>"

# Security & CORS
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,https://hunar.courses/
