# MongoDB Connection String
# Replace with your local MongoDB or MongoDB Atlas URI:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/hunar_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://byteblazehunar_db_user:hunar123@byteblaze.info.database@hunartheskillhouse@ecommerce.9ajwded.mongodb.net/?appName=ECommerce

# JWT Secret for Session Authentication
# In production, use a strong 256-bit random string
JWT_SECRET=hunar-super-secret-jwt-key-2026-mullanpur-dakha

# Invitation Token Expiry (in hours)
